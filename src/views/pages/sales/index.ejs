<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
<style>
  .pos-btn {
    background: #6f42c1;
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: 0.2s;
  }
  .pos-btn:hover { background: #5a32a3; color: white; }
</style>
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
      <div><h1 class="page-title">Sales History</h1></div>
    </div>
    <a href="/sales/pos" class="pos-btn"><i class="fas fa-cash-register"></i> Open POS</a>
  </div>

  <div class="stats-grid" style="grid-template-columns:repeat(2,1fr)">
    <div class="stat-card" style="background:#fff">
      <div class="stat-icon" style="background:#EEEDFE;color:#6f42c1"><i class="fas fa-receipt"></i></div>
      <div class="stat-body">
        <span class="stat-label">Today's Receipts</span>
        <span class="stat-val"><%= summary && summary.total_receipts ? summary.total_receipts : 0 %></span>
      </div>
    </div>
    <div class="stat-card" style="background:#fff">
      <div class="stat-icon" style="background:#e0f7ef;color:#00b87f"><i class="fas fa-coins"></i></div>
      <div class="stat-body">
        <span class="stat-label">Today's Revenue</span>
        <span class="stat-val"><%= typeof formatCurrency === 'function' && summary ? formatCurrency(summary.total_revenue, user.currency) : (summary ? summary.total_revenue : 0) %></span>
      </div>
    </div>
  </div>

  <div style="padding:0 2rem 2rem">
    <div class="dash-card">
      <div class="card-header"><h2>Recent Sales</h2></div>
      <% if(!sales || sales.length === 0){ %>
        <div class="empty-state">
          <i class="fas fa-shopping-cart"></i>
          <p>No sales recorded yet.</p>
          <a href="/sales/pos" class="btn-add-sm">Open POS →</a>
        </div>
      <% }else{ %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Receipt #</th>
            <th>Cashier</th>
            <th>Amount</th>
            <th>Payment</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
        <% sales.forEach(sale => { %>
        <tr>
          <td><%= typeof formatDate === 'function' ? formatDate(sale.created_at) : sale.created_at %></td>
          <td style="font-family:monospace;font-weight:600;color:#6f42c1"><%= sale.receipt_number %></td>
          <td><%= sale.cashier_name || 'System' %></td>
          <td style="font-weight:600;"><%= typeof formatCurrency === 'function' ? formatCurrency(sale.total_amount, user.currency) : sale.total_amount %></td>
          <td>
            <% if(sale.payment_method === 'cash') { %> <span class="badge" style="background:#e8f0fe;color:#1967d2">Cash</span> <% } %>
            <% if(sale.payment_method === 'mpesa') { %> <span class="badge" style="background:#e0f7ef;color:#00b87f">M-Pesa</span> <% } %>
            <% if(sale.payment_method === 'card') { %> <span class="badge" style="background:#fef3dc;color:#b87a00">Card</span> <% } %>
          </td>
          <td>
            <% if(sale.status === 'completed'){ %> <span style="color:#00b87f;font-size:12px;font-weight:600"><i class="fas fa-check-circle"></i> Completed</span> <% } %>
            <% if(sale.status === 'refunded'){ %> <span style="color:#dc3545;font-size:12px;font-weight:600"><i class="fas fa-rotate-left"></i> Refunded</span> <% } %>
            <% if(sale.status === 'cancelled'){ %> <span style="color:#888;font-size:12px;font-weight:600"><i class="fas fa-ban"></i> Cancelled</span> <% } %>
          </td>
        </tr>
        <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</main>
<script src="/js/dashboard.js"></script>
</body></html>
