<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
<style>
  .quote-builder { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; }
  .form-group { margin-bottom: 1rem; }
  .form-group label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 6px; color: #495057; }
  .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #ced4da; border-radius: 6px; font-size: 14px; box-sizing: border-box; }
  .item-row { display: flex; gap: 10px; align-items: flex-end; margin-bottom: 10px; padding: 10px; border: 1px solid #e9ecef; border-radius: 8px; background: #f8f9fa; }
  .item-row .col-desc { flex: 2; }
  .item-row .col-qty { flex: 0.5; }
  .item-row .col-price { flex: 1; }
  .item-row .col-action { flex: 0.2; text-align: center; }
  .btn-remove { background: #ffe3e3; color: #dc3545; border: none; padding: 10px; border-radius: 6px; cursor: pointer; transition: 0.2s; }
  .btn-remove:hover { background: #ffcdd2; }
  .totals-box { background: #e8f0fe; padding: 1.5rem; border-radius: 8px; margin-top: 1rem; }
  .totals-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px; }
  .totals-row.grand { font-size: 18px; font-weight: 700; color: #1967d2; border-top: 1px solid #cddcff; padding-top: 10px; margin-top: 10px; }
</style>
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
      <div><h1 class="page-title"><%= title %></h1></div>
    </div>
    <a href="/quotations" class="btn-close" style="color:#6c757d; text-decoration:none; font-weight:600;"><i class="fas fa-arrow-left"></i> Back</a>
  </div>

  <div style="padding:2rem;">
    <div class="quote-builder">
      <!-- Left: Line Items -->
      <div class="dash-card" style="padding:1.5rem">
        <h2 style="font-size:16px; margin-bottom:1rem; border-bottom:1px solid #e9ecef; padding-bottom:8px;">Line Items</h2>
        
        <div id="itemsContainer"></div>
        
        <div style="display:flex; gap:10px; margin-top:1rem;">
          <button type="button" class="btn-add-sm" onclick="addCustomItem()" style="background:#e9ecef; color:#495057"><i class="fas fa-plus"></i> Add Custom Item</button>
          <% if(inventoryItems && inventoryItems.length > 0) { %>
          <div style="flex:1; display:flex; gap:10px;">
            <select id="inventorySelect" style="flex:1; padding:8px; border-radius:6px; border:1px solid #ced4da;">
              <option value="">-- Add from Inventory --</option>
              <% inventoryItems.forEach(i => { %>
                <option value="<%= i.id %>" data-name="<%= i.name %>" data-price="<%= i.sell_price %>"><%= i.name %> (<%= i.sell_price %>)</option>
              <% }) %>
            </select>
            <button type="button" class="btn-add-sm" onclick="addInventoryItem()"><i class="fas fa-plus"></i> Add</button>
          </div>
          <% } %>
        </div>

        <div class="totals-box">
          <div class="totals-row"><span>Subtotal</span><span id="subtotalDisplay">0.00</span></div>
          <div class="totals-row grand"><span>Total</span><span id="totalDisplay">0.00</span></div>
        </div>
      </div>

      <!-- Right: Quote Details -->
      <div class="dash-card" style="padding:1.5rem; height:fit-content;">
        <h2 style="font-size:16px; margin-bottom:1rem; border-bottom:1px solid #e9ecef; padding-bottom:8px;">Quote Details</h2>
        
        <div class="form-group">
          <label>Customer</label>
          <select id="customerId" onchange="handleCustomerChange()">
            <option value="">-- Select Existing Customer --</option>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>" data-name="<%= c.name %>" data-email="<%= c.email %>" <%= quotation && quotation.customer_id === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>

        <div id="newCustomerFields" style="<%= quotation && quotation.customer_id ? 'display:none;' : '' %>">
          <div class="form-group">
            <label>Customer Name</label>
            <input type="text" id="customerName" placeholder="John Doe" value="<%= quotation ? quotation.customer_name : '' %>">
          </div>
          <div class="form-group">
            <label>Customer Email</label>
            <input type="email" id="customerEmail" placeholder="john@example.com" value="<%= quotation ? quotation.customer_email : '' %>">
          </div>
        </div>

        <div class="form-group">
          <label>Valid Until</label>
          <input type="date" id="validUntil" value="<%= quotation && quotation.valid_until ? new Date(quotation.valid_until).toISOString().split('T')[0] : '' %>">
        </div>

        <div class="form-group">
          <label>Notes (Optional)</label>
          <textarea id="notes" rows="3" placeholder="Terms and conditions..."><%= quotation ? quotation.notes : '' %></textarea>
        </div>

        <button type="button" class="btn-submit" id="btnSave" style="width:100%; margin-top:1rem;" onclick="saveQuote()">Save Quotation</button>
      </div>
    </div>
  </div>
</main>

<script>
  let items = [];
  const qId = '<%= quotation ? quotation.id : "" %>';
  
  // Load existing items if editing
  <% if(items && items.length > 0) { %>
    items = <%- JSON.stringify(items) %>.map(i => ({
      id: Math.random().toString(36).substr(2, 9),
      itemId: i.item_id,
      description: i.description,
      quantity: i.quantity,
      unitPrice: i.unit_price
    }));
  <% } else { %>
    addCustomItem();
  <% } %>

  function renderItems() {
    const container = document.getElementById('itemsContainer');
    container.innerHTML = '';
    let total = 0;

    items.forEach((item, index) => {
      const subtotal = item.quantity * item.unitPrice;
      total += subtotal;

      container.innerHTML += `
        <div class="item-row">
          <div class="col-desc">
            <label>Description</label>
            <input type="text" value="${item.description}" onchange="updateItem('${item.id}', 'description', this.value)" placeholder="Service/Product name" ${item.itemId ? 'readonly style="background:#e9ecef"' : ''}>
          </div>
          <div class="col-qty">
            <label>Qty</label>
            <input type="number" min="1" value="${item.quantity}" onchange="updateItem('${item.id}', 'quantity', this.value)">
          </div>
          <div class="col-price">
            <label>Unit Price</label>
            <input type="number" min="0" step="0.01" value="${item.unitPrice}" onchange="updateItem('${item.id}', 'unitPrice', this.value)" ${item.itemId ? 'readonly style="background:#e9ecef"' : ''}>
          </div>
          <div class="col-action">
            <button class="btn-remove" onclick="removeItem('${item.id}')"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      `;
    });

    document.getElementById('subtotalDisplay').textContent = total.toLocaleString();
    document.getElementById('totalDisplay').textContent = total.toLocaleString();
  }

  function addCustomItem() {
    items.push({ id: Math.random().toString(36).substr(2, 9), itemId: null, description: '', quantity: 1, unitPrice: 0 });
    renderItems();
  }

  function addInventoryItem() {
    const select = document.getElementById('inventorySelect');
    if(!select.value) return;
    const option = select.options[select.selectedIndex];
    items.push({
      id: Math.random().toString(36).substr(2, 9),
      itemId: select.value,
      description: option.dataset.name,
      quantity: 1,
      unitPrice: parseFloat(option.dataset.price)
    });
    select.value = '';
    renderItems();
  }

  function updateItem(id, field, value) {
    const item = items.find(i => i.id === id);
    if(item) {
      if(field === 'quantity' || field === 'unitPrice') item[field] = parseFloat(value) || 0;
      else item[field] = value;
      renderItems();
    }
  }

  function removeItem(id) {
    items = items.filter(i => i.id !== id);
    renderItems();
  }

  function handleCustomerChange() {
    const sel = document.getElementById('customerId');
    const newFields = document.getElementById('newCustomerFields');
    if(sel.value) {
      newFields.style.display = 'none';
    } else {
      newFields.style.display = 'block';
    }
  }

  async function saveQuote() {
    const btn = document.getElementById('btnSave');
    
    // Validation
    const cleanItems = items.filter(i => i.description.trim() !== '');
    if(cleanItems.length === 0) return alert('Please add at least one valid item');
    
    const customerId = document.getElementById('customerId').value;
    const customerName = document.getElementById('customerName').value;
    if(!customerId && !customerName) return alert('Please select a customer or enter a name');

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

    const payload = {
      id: qId || null,
      customerId: customerId || null,
      customerName: customerName,
      customerEmail: document.getElementById('customerEmail').value,
      validUntil: document.getElementById('validUntil').value,
      notes: document.getElementById('notes').value,
      items: cleanItems
    };

    try {
      const res = await fetch('/api/quotations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if(data.success) {
        window.location.href = '/quotations/' + data.quotationId;
      } else {
        alert(data.error || 'Failed to save');
        btn.disabled = false;
        btn.textContent = 'Save Quotation';
      }
    } catch(err) {
      alert('Network error');
      btn.disabled = false;
      btn.textContent = 'Save Quotation';
    }
  }

  // Init
  renderItems();
</script>
</body>
</html>
