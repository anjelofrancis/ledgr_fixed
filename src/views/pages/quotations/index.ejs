<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
      <div><h1 class="page-title">Quotations & Estimates</h1></div>
    </div>
    <a href="/quotations/new" class="btn-add"><i class="fas fa-plus"></i> New Quote</a>
  </div>

  <div style="padding:2rem">
    <div class="dash-card">
      <div class="card-header"><h2>All Quotations</h2></div>
      <% if (!quotations || quotations.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-file-invoice" style="font-size:32px; color:#adb5bd; margin-bottom:1rem"></i>
          <p>No quotations created yet.</p>
          <a href="/quotations/new" class="btn-add-sm">Create First Quote</a>
        </div>
      <% } else { %>
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Quote #</th>
              <th>Customer</th>
              <th>Total Amount</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
          <% quotations.forEach(q => { %>
            <tr>
              <td><%= typeof formatDate === 'function' ? formatDate(q.created_at) : new Date(q.created_at).toLocaleDateString() %></td>
              <td style="font-family:monospace; font-weight:600;"><a href="/quotations/<%= q.id %>" style="color:#6f42c1; text-decoration:none;"><%= q.quote_number %></a></td>
              <td>
                <div style="font-weight:600; font-size:13px"><%= q.customer_name_linked || q.customer_name || 'Walk-in' %></div>
                <div style="font-size:11px; color:#6c757d"><%= q.customer_email || '' %></div>
              </td>
              <td style="font-weight:600;"><%= typeof formatCurrency === 'function' ? formatCurrency(q.total_amount, user.currency) : q.total_amount %></td>
              <td>
                <% if(q.status === 'draft') { %> <span class="badge" style="background:#e9ecef;color:#495057">Draft</span> <% } %>
                <% if(q.status === 'sent') { %> <span class="badge" style="background:#e8f0fe;color:#1967d2">Sent</span> <% } %>
                <% if(q.status === 'accepted') { %> <span class="badge" style="background:#e0f7ef;color:#00b87f">Accepted</span> <% } %>
                <% if(q.status === 'rejected') { %> <span class="badge" style="background:#fce8e9;color:#dc3545">Rejected</span> <% } %>
                <% if(q.status === 'expired') { %> <span class="badge" style="background:#fff3cd;color:#856404">Expired</span> <% } %>
                <% if(q.status === 'converted') { %> <span class="badge" style="background:#d4edda;color:#155724"><i class="fas fa-check-double"></i> Converted</span> <% } %>
              </td>
              <td>
                <a href="/quotations/<%= q.id %>" style="color:#6f42c1; font-size:13px; font-weight:600; text-decoration:none;">View</a>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</main>
<script src="/js/dashboard.js"></script>
</body>
</html>
