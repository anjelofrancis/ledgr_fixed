<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/auth.css">
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
      <div><h1 class="page-title"><%= typeof item !== 'undefined' && item ? 'Edit Product' : 'Add Product' %></h1></div>
    </div>
    <a href="/inventory" style="font-size:13px;color:#888">← Back</a>
  </div>
  <div style="padding:2rem;max-width:600px">
    <div class="dash-card" style="padding:2rem">
      <% if(typeof error !== 'undefined' && error){ %><div class="alert alert-error"><%= error %></div><% } %>
      <form action="<%= typeof item !== 'undefined' && item ? '/inventory/'+item.id+'/update' : '/inventory' %>" method="POST" class="auth-form">
        <div class="form-row">
          <div class="form-group"><label>Name</label><input type="text" name="name" value="<%= typeof item !== 'undefined' && item ? item.name : '' %>" required></div>
          <div class="form-group"><label>SKU</label><input type="text" name="sku" value="<%= typeof item !== 'undefined' && item ? item.sku : '' %>"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Category</label>
            <select name="categoryId">
              <option value="">Select category…</option>
              <% if(typeof categories !== 'undefined'){ categories.forEach(c => { %><option value="<%= c.id %>" <%= typeof item !== 'undefined' && item && item.category_id == c.id ? 'selected' : '' %>><%= c.name %></option><% }) } %>
            </select>
          </div>
          <div class="form-group"><label>Currency</label>
            <select name="currency">
              <% ['KES','USD','EUR','GBP','TZS','UGX'].forEach(cur => { %><option value="<%= cur %>" <%= typeof item !== 'undefined' && item && item.currency === cur ? 'selected' : '' %>><%= cur %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <% if(typeof item === 'undefined' || !item){ %>
          <div class="form-group"><label>Initial Quantity</label><input type="number" name="quantity" value="0" min="0" required></div>
          <% } %>
          <div class="form-group"><label>Reorder Level</label><input type="number" name="reorder_level" value="<%= typeof item !== 'undefined' && item ? item.reorder_level : 5 %>" min="0" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Cost Price</label><input type="number" name="cost_price" value="<%= typeof item !== 'undefined' && item ? item.cost_price : '' %>" min="0" step="0.01"></div>
          <div class="form-group"><label>Sell Price</label><input type="number" name="sell_price" value="<%= typeof item !== 'undefined' && item ? item.sell_price : '' %>" min="0" step="0.01"></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Supplier</label><input type="text" name="supplier" value="<%= typeof item !== 'undefined' && item ? item.supplier : '' %>"></div>
          <div class="form-group"><label>Location / Shelf</label><input type="text" name="location" value="<%= typeof item !== 'undefined' && item ? item.location : '' %>"></div>
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="3" style="width:100%;padding:8px;border:1px solid #ddd;border-radius:6px;font-family:inherit;font-size:14px;"><%= typeof item !== 'undefined' && item ? item.description : '' %></textarea>
        </div>
        <button type="submit" class="btn-submit">Save Product</button>
      </form>
    </div>
  </div>
</main>
<script src="/js/dashboard.js"></script>
</body></html>
